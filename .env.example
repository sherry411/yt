# ── TrackGrab backend — example environment ──────────────────────────────────
# Copy to `.env` (gitignored) and adjust. Every value here is optional; the
# backend ships working defaults. See VPS-DEPLOYMENT.md "Performance & accuracy
# tuning" for the knobs that matter most.

# ── Core ─────────────────────────────────────────────────────────────────────
# PORT=3000
# Shared HMAC secret — MUST match the WordPress plugin's "Shared API secret".
# Leave unset to use the baked-in default (works out of the box, not secure).
# SCLOUD_API_SECRET=change-me-to-a-long-random-string
# SCLOUD_API_OPEN=0            # 1 = disable auth entirely (not recommended)
# SIG_LEEWAY_S=600             # clock-drift grace for signed links (seconds)
# CORS_ALLOWED_ORIGINS=https://yoursite.com,https://www.yoursite.com

# ── Tool locations (defaults use PATH) ───────────────────────────────────────
# YTDLP_PATH=yt-dlp
# FFMPEG_LOCATION=/usr/local/bin      # dir containing ffmpeg + ffprobe
# YTDLP_CACHE_DIR=/tmp/yt-dlp-cache

# ── Speed: downloader & parallelism ──────────────────────────────────────────
# aria2c is auto-detected when on PATH (3–10× faster). Force with 1 / 0:
# YTDLP_ARIA2=1
# YTDLP_ARIA2_ARGS=-x16 -s16 -k1M
# YTDLP_FRAGMENTS=8                   # parallel DASH fragments (native downloader)
# YT_MAX_CONCURRENT=4                 # simultaneous jobs (default: CPU cores, 2–4)
# YT_MAX_QUEUE=30
# YT_DOWNLOAD_TIMEOUT_S=900

# ── Speed: info cache ────────────────────────────────────────────────────────
# YT_INFO_CACHE_TTL_S=1800            # cache /yt-info + /yt-video-info (0 disables)

# ── Accuracy / anti-bot ──────────────────────────────────────────────────────
# Extractor client. Unset → youtube:player_client=default,android,web_safari
# (avoids throttled web-client URLs). Multiple groups separated by ";;".
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=default,android,web_safari
# YT_PROXY_RETRIES=3                  # retries with a fresh proxy on a bot-check
# Cookies (clears most "Sign in to confirm you're not a bot"):
#   drop a cookies.txt next to the app (auto-used, gitignored), or:
# YTDLP_COOKIES=/path/to/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome
# Proxy pool: a single proxy here, and/or a gitignored proxies.txt (one per line).
# YTDLP_PROXY=http://user:pass@host:port
